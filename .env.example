# =============================================================================
# BitJunoo - Environment Variables
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control.
# =============================================================================

# ── Application ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── MongoDB ──────────────────────────────────────────────────────────────────
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.mongodb.net/bitjunoo?retryWrites=true&w=majority

# ── Authentication (JWT / NextAuth) ───────────────────────────────────────────
# Generate a strong random secret: openssl rand -base64 64
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# ── Cloudinary ────────────────────────────────────────────────────────────────
# Get these from your Cloudinary Dashboard → Settings → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Optional: default upload folder
CLOUDINARY_UPLOAD_FOLDER=bitjunoo/uploads

